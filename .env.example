# Copy to `.env.test` at the repo root for local / dev / test.
# `.env.test` is gitignored — keep it only on your machine; never commit it.
#
# Production: use Netlify project environment variables only (no secrets in the repo).

# Resend — server-side or Supabase SMTP password; never prefix with VITE_
RESEND_API_KEY=

# Client-exposed (Vite) — examples; add whatever this app needs:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_URL_TEST=
# VITE_SUPABASE_ANON_KEY_TEST=
