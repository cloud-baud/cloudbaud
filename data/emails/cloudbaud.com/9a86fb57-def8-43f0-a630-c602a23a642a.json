es/USSBAOIG/2024/10/10426279/oig1_original.png\" style=\"width: 600px; height: auto; -ms-interpolation-mode: bicubic; line-height: 1; outline: none; text-decoration: none; max-width: 100%; border: none;\" alt=\"U.S. Small Business Administration - Office of Inspector General (SBA-OIG)\" width=\"600\" height=\"261\"></a></td></tr></table></td>\n    </tr>\n  </table>\n</div>\n<!--[if (gte mso 9)|(IE)]>\n  </td>\n<![endif]-->\n<!--[if (gte mso 9)|(IE)]>\n  </tr>\n  </table>\n<![endif]-->\n      </td>\n    </tr>\n  </table>\n</div>\n<!--[if (gte mso 9)|(IE)]>\n      </td>\n    </tr>\n  </table>\n<![endif]-->\n<!--[if (gte mso 9)|(IE)]>\n  <table width=\"600\" align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n    <tr>\n      <td>\n<![endif]-->\n<div class=\"abe-section-block\" data-block-type=\"FancyBlockSection\" data-test=\"test\" data-block-id=\"167649674\">\n  <table class=\"abe-section-table\" width=\"100%\" align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"max-width: 600px; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; border-spacing: 0; mso-table-lspace: 0pt; mso-table-rspace: 0pt;\">\n    <tr id=\"abe-section-row-c1deffa0-6816-4310-9143-da783c4676fc\" class=\"abe-section-row\" style=\"background-color: #f6f6f6;\" bgcolor=\"#f6f6f6\">\n      <td style=\"text-align: center; vertical-align: top; font-size: 0; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; mso-table-lspace: 0pt; mso-table-rspace: 0pt;\" align=\"center\" valign=\"top\">\n        <!--[if (gte mso 9)|(IE)]>\n  <table width=\"100%\" align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; border-spacing: 0; mso-table-lspace: 0pt; mso-table-rspace: 0pt;\">\n    <tr>\n<![endif]-->\n<!--[if (gte mso 9)|(IE)]>\n  <td width=\"600\" valign=\"top\" id=\"abe-column-block-31174c74-961f-4559-9968-a2d83f53ef62-outlook-only\" class=\"abe-column-block-outlook-only\" style=\"-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; mso-table-lspace: 0pt; mso-table-rspace: 0pt;\">\n<![endif]-->\n<div id=\"abe-column-block-31174c74-961f-4559-9968-a2d83f53ef62\" class=\"abe-column-block\" data-block-type=\"FancyBlockColumn\" data-block-id=\"167649675\" style=\"width: 100%; box-sizing: border-box; display: inline-block; font-size: 16px; vertical-align: top;\">\n  <table width=\"100%\" align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"table-layout: fixed; overflow-wrap: break-word; word-wrap: break-word; text-align: left; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; border-spacing: 0; mso-table-lspace: 0pt; mso-table-rspace: 0pt;\">\n    <tr>\n      <td class=\"abe-column-block-padding\" id=\"abe-column-block-31174c74-961f-4559-9968-a2d83f53ef62-padding\" style=\"-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; mso-table-lspace: 0pt; mso-table-rspace: 0pt; padding: 30px;\">\n<h1 class=\"govd_header\" style=\"line-height: 1.2; font-family: calibri, candara, segoe, optima, arial, sans-serif; font-size: 22px; color: #000000; text-align: left; margin: 0 0 15px;\" align=\"left\"><a href=\"https://links-1.govdelivery.com/CL0/https:%2F%2Fwww.sba.gov%2Fdocument%2Freport-semiannual-report-congress%3Futm_medium=email%26utm_source=govdelivery/1/0100019e5075f315-42484efc-e87d-4466-b10f-6bdc72b14d29-000000/HD8CygtWfxanFbsptfQ2DST7OENAioGeo6oZ9MZwQOg=452\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"SBA OIG - Spring 2026 Semiannual Report to Congress\" style=\"-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; color: #000000;\">U.S. Small Business Administration, Office of Inspector General's Spring 2026 - Semiannual Report to Congress</a></h1>\n<p style=\"-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; line-height: 1.4; font-family: calibri, candara, segoe, optima, arial, sans-serif; font-size: 15px; color: #000000; text-align: left; margin: 0 0 15px;\" align=\"left\">Today, the U.S. Small Business Administration (SBA), Office of Inspector General (OIG) is pleased to present the Spring 2026 - Semiannual Report to Congress. This report summarizes OIG’s activities from October 1, 2025 through March 31, 2026.</p>\n<p style=\"-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; line-height: 1.4; font-family: calibri, candara, segoe, optima, arial, sans-serif; font-size: 15px; color: #000000; text-align: left; margin: 0 0 15px;\" align=\"left\">You may read the report by <strong><a href=\"https://links-1.govdelivery.com/CL0/https:%2F%2Fwww.sba.gov%2Fdocument%2Freport-semiannual-report-congress%3Futm_medium=email%26utm_source=govdelivery/2/0100019e5075f315-42484efc-e87d-4466-b10f-6bdc72b14d29-000000/kt1gmi1D018GUK27y9B5Divn99p3_FpAymudgbhlkfQ=452\" target=\"_blank\" title=\"SBA OIG - Spring 2026 Semiannual Report to Congress\" rel=\"noopener\" style=\"-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; color: #005999;\">CLICKING HERE</a></strong>.</p>\n<p style=\"-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; line-height: 1.4; font-family: calibri, candara, segoe, optima, arial, sans-serif; font-size: 15px; color: #000000; text-align: left; margin: 0 0 15px;\" align=\"left\">During this reporting period, OIG continued to bring fraudsters to justice and provide a significant return on investment to American taxpayers. During the 6-month period from October 2025 through March 2026, OIG issued 8 audit reports with 13 recommendations to improve SBA operations and mitigate fraud and unnecessary losses in agency programs. We questioned $32 billion in costs from our oversight reviews. In addition, OIG investigations resulted in 83 indictments, 52 convictions, and over $244 million in dollar accomplishments — bringing our total monetary accomplishments to about $32.3 billion.</p>\n<p style=\"-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; line-height: 1.4; font-family: calibri, candara, segoe, optima, arial, sans-serif; font-size: 15px; color: #000000; text-align: left; margin: 0 0 15px;\" align=\"left\">The nation can depend on OIG to provide independent, objective, and timely oversight of SBA. OIG’s engaged workforce will continue to give taxpayers a significant return on investment, rooting out fraud, waste, and abuse in SBA programs.</p>\n<table class=\"govd_button\" width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; border-spacing: 0; mso-table-lspace: 0pt; mso-table-rspace: 0pt;\"><tbody><tr><td style=\"-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; mso-table-lspace: 0pt; mso-table-rspace: 0pt; padding-bottom: 10px;\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; border-spacing: 0; mso-table-lspace: 0pt; mso-table-rspace: 0pt; margin: 0 auto;\" align=\"center\"><tbody><tr><td class=\"govd_button\" style=\"-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; mso-table-lspace: 0pt; mso-table-rspace: 0pt; background-color: #005999; border-radius: 4px; text-align: center; display: inline-block; overflow-wrap: break-word; word-wrap: break-word; -ms-word-break: break-all; word-break: break-word; padding: 10px 20px; border: none;\" align=\"center\" bgcolor=\"#005999\"><a href=\"https://links-1.govdelivery.com/CL0/https:%2F%2Fwww.sba.gov%2Fdocument%2Freport-semiannual-report-congress%3Futm_medium=email%26utm_source=govdelivery/3/0100019e5075f315-42484efc-e87d-4466-b10f-6bdc72b14d29-000000/qvPfE6VZ0N-1-gWAGjndlQwPmgIHvorYtXS7Bim7ekM=452\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"SBA OIG - Spring 2026 Semiannual Report to Congress\" style=\"-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; text-decoration: none !important;\"><strong style=\"font-family: calibri, candara, segoe, optima, arial, sans-serif; font-size: 16px; color: #FFFFFF; text-decoration: none;\">Share This Report</strong></a></td></tr></tbody></table></td></tr></tbody></table>\n</td>\n    </tr>\n  </table>\n</div>\n<!--[if (gte mso 9)|(IE)]>\n  </td>\n<![endif]-->\n<!--[if (gte mso 9)|(IE)]>\n  </tr>\n  </table>\n<![endif]-->\n      </td>\n    </tr>\n  </table>\n</div>\n<!--[if (gte mso 9)|(IE)]>\n      </td>\n    </tr>\n  </table>\n<![endif]-->\n</td>\n    <td style=\"-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; mso-table-lspace: 0pt; mso-table-rspace: 0pt;\"></td>\n  </tr>\n</table>\n</td></tr></table>\n  \n\n\n<div id=\"mail_footer\">\n    <table width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" align=\"center\">\n<tbody>\n<tr>\n<td style=\"background: #FFFFFF;\" align=\"center\" bgcolor=\"#FFFFFF\" width=\"100%\">\n<!--[if mso]>\n<table width=\"600\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:600px;\">\n<tr>\n<td>\n<![endif]-->\n<div style=\"margin: 0 auto; max-width: 600px; width: 100%;\">\n<table style=\"border-collapse: collapse;\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" align=\"center\">\n<tbody>\n<tr>\n<td style=\"text-align: center; padding: 0 20px 10px 20px;\" align=\"center\" width=\"100\">\n<p style=\"-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; line-height: 1.4; font-family: calibri, candara, segoe, optima, arial, sans-serif; font-size: 16px; color: #000000; text-align: center; margin: 0 0 10px;\" align=\"center\">Report fraud, waste, abuse, mismanagement, or misconduct <br>involving SBA programs or employees.</p>\n<table class=\"govd_button\" style=\"-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; border-spacing: 0; mso-table-lspace: 0pt; mso-table-rspace: 0pt;\" border=\"0\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td style=\"-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; mso-table-lspace: 0pt; mso-table-rspace: 0pt; padding-top: 0; padding-bottom: 20px;\">\n<table style=\"-webkit-text-size-ad