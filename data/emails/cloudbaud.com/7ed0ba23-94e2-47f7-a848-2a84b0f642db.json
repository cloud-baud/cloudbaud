:#ffffff;\">\n    <![endif]-->\n    <!--[if (mso)|(IE)]>\n  <td valign=\"top\" style=\"width:600px;\">\n<![endif]-->\n<!--[if gte mso 9]>\n  <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:600px\">\n<![endif]-->\n<div id=\"column_1779212601776_0\" class=\"hse-column hse-size-12\">\n  <div id=\"hs_cos_wrapper_module_17792126017462\" class=\"hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_module\" style=\"color: inherit; font-size: inherit; line-height: inherit;\" data-hs-cos-general-type=\"widget\" data-hs-cos-type=\"module\"><table class=\"hse-image-wrapper\" role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td align=\"center\" valign=\"top\" style=\"font-family:Arial, sans-serif; color:#23496d; word-break:break-word; text-align:center; padding:10px 0px; font-size:0px\">\n        <img alt=\"MicroDrama\" src=\"https://stories.contus.com/hs-fs/hubfs/MicroDrama.png?width=1120&amp;upscale=true&amp;name=MicroDrama.png\" style=\"outline:none; text-decoration:none; max-width:100%; font-size:16px\" width=\"560\" align=\"middle\">\n      </td>\n    </tr>\n  </tbody>\n</table></div>\n</div>\n<!--[if gte mso 9]></table><![endif]-->\n<!--[if (mso)|(IE)]></td><![endif]-->\n    <!--[if (mso)|(IE)]></tr></table><![endif]-->\n    </div>\n   \n  </div>\n  <div id=\"section-0\" class=\"hse-section\" style=\"padding-left:10px; padding-right:10px\">\n    \n    \n      <div class=\"hse-column-container\" style=\"min-width:280px; max-width:600px; margin:0 auto; background-color:#ffffff\" bgcolor=\"#ffffff\">\n    \n    <!--[if (mso)|(IE)]>\n      <table align=\"center\" style=\"width:600px;\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"600\" bgcolor=\"#ffffff\">\n      <tr style=\"background-color:#ffffff;\">\n    <![endif]-->\n    <!--[if (mso)|(IE)]>\n  <td valign=\"top\" style=\"width:600px;\">\n<![endif]-->\n<!--[if gte mso 9]>\n  <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:600px\">\n<![endif]-->\n<div id=\"column-0-0\" class=\"hse-column hse-size-12\">\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" class=\"\" style=\"\"><tbody><tr><td class=\"hs_padded\" style=\"font-family:Arial, sans-serif; font-size:15px; color:#23496d; word-break:break-word; padding:10px 20px\"><div id=\"hs_cos_wrapper_module_17792125238751\" class=\"hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_module\" style=\"color: inherit; font-size: inherit; line-height: inherit;\" data-hs-cos-general-type=\"widget\" data-hs-cos-type=\"module\"><div id=\"hs_cos_wrapper_module_17792125238751_\" class=\"hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_rich_text\" style=\"color: inherit; font-size: inherit; line-height: inherit;\" data-hs-cos-general-type=\"widget\" data-hs-cos-type=\"rich_text\"><p style=\"text-align:left; font-size:16px; line-height:175%\" align=\"left\"><span style=\"font-family: 'Times New Roman', Times, serif; color: #000000; font-size: 14px;\">Hi Jishnu</span></p>\n<p style=\"text-align:left; font-size:16px; line-height:175%\" align=\"left\">&nbsp;</p>\n<p style=\"text-align:left; font-size:16px; line-height:175%\" align=\"left\"><span style=\"font-family: 'Times New Roman', Times, serif; color: #000000; font-size: 14px;\">Did you know? </span></p>\n<p style=\"text-align:left; font-size:16px; line-height:175%\" align=\"left\"><span style=\"font-family: 'Times New Roman', Times, serif; color: #000000; font-size: 14px;\">Users across the globe now spend an average of <span style=\"font-weight: bold;\">2 hours daily</span> watching <span style=\"font-weight: bold;\">short-form</span> <span style=\"font-weight: bold;\">vertical content</span> on microdrama apps.&nbsp;</span></p>\n<p style=\"text-align:left; font-size:16px; line-height:175%\" align=\"left\">&nbsp;</p>\n<p style=\"text-align:left; font-weight:bold; font-size:16px; line-height:175%\" align=\"left\"><span style=\"font-family: 'Times New Roman', Times, serif; color: #000000; font-size: 14px;\">People no longer want:</span></p>\n<p style=\"text-align:left; font-size:16px; line-height:175%\" align=\"left\"><span style=\"font-family: 'Times New Roman', Times, serif; color: #000000; font-size: 14px;\">❌ Long movies</span><br><span style=\"font-family: 'Times New Roman', Times, serif; color: #000000; font-size: 14px;\">❌ Slow-paced web series</span><br><span style=\"font-family: 'Times New Roman', Times, serif; color: #000000; font-size: 14px;\">❌ Endless binge watching</span></p>\n<p style=\"text-align:left; font-size:16px; line-height:175%\" align=\"left\">&nbsp;</p>\n<p style=\"text-align:left; font-weight:bold; font-size:16px; line-height:175%\" align=\"left\"><span style=\"font-family: 'Times New Roman', Times, serif; color: #000000; font-size: 14px;\">Now audiences want:</span></p>\n<p style=\"text-align:left; font-size:16px; line-height:175%\" align=\"left\"><span style=\"font-family: 'Times New Roman', Times, serif; color: #000000; font-size: 14px;\">✅ 30-second to 2-minute episodes</span><br><span style=\"font-family: 'Times New Roman', Times, serif; color: #000000; font-size: 14px;\">✅ Fast emotional storytelling</span><br><span style=\"font-family: 'Times New Roman', Times, serif; color: #000000; font-size: 14px;\">✅ Vertical mobile-first experiences</span></p>\n<p style=\"text-align:left; font-size:16px; line-height:175%\" align=\"left\">&nbsp;</p>\n<p style=\"text-align:left; font-size:16px; line-height:175%\" align=\"left\"><span style=\"font-family: 'Times New Roman', Times, serif; color: #000000; font-size: 14px;\"><span style=\"font-weight: bold;\">Microdrama apps like ReelShort, DramaBox and ShortMax</span> are already generating multi-million-dollar revenues via subscriptions, coin-based and pay-per-episode models.</span></p>\n<p style=\"text-align:left; font-size:16px; line-height:175%\" align=\"left\">&nbsp;</p>\n<p style=\"text-align:left; font-size:16px; line-height:175%; font-weight:bold\" align=\"left\"><span style=\"font-family: 'Times New Roman', Times, serif; color: #000000; font-size: 14px;\">Still thinking?</span></p>\n<p style=\"text-align:left; font-size:16px; line-height:175%\" align=\"left\">&nbsp;</p>\n<p style=\"text-align:left; font-size:16px; line-height:175%\" align=\"left\"><span style=\"font-family: 'Times New Roman', Times, serif; color: #000000; font-size: 14px;\">With <span style=\"font-weight: bold;\">VPlayed</span>, you can launch your own <span style=\"font-weight: bold;\">white-label microdrama streaming app</span> with vertical video experiences, coin-based monetization and <span style=\"font-weight: bold;\">AI-powered</span> content recommendations.&nbsp;</span></p>\n<p style=\"text-align:left; font-size:16px; line-height:175%\" align=\"left\">&nbsp;</p>\n<p style=\"text-align:left; font-size:16px; line-height:175%\" align=\"left\"><span style=\"font-family: 'Times New Roman', Times, serif; color: #000000; font-size: 14px;\">Get multi-device OTT accessibility along with complete <span style=\"font-weight: bold;\">source-code and platform ownership</span>.</span></p>\n<p style=\"text-align:left; font-size:16px; line-height:175%\" align=\"left\">&nbsp;</p>\n<p style=\"text-align:left; font-size:16px; line-height:175%\" align=\"left\"><span style=\"font-family: 'Times New Roman', Times, serif; color: #000000; font-size: 14px;\">Here is a quick read on how <span style=\"font-weight: bold;\">content owners</span> are building and monetizing content with microdrama apps 👉<a href=\"https://stories.contus.com/e3t/Ctc/OL+113/c3Ytt04/VW9sh32s59VvW1njdxt3lL5mrW69sl4k5PhyFCN67vcnP3lYM-W7lCdLW6lZ3pPVhqTkh81610LVR_vTp3vjjBVVMdpsT1xD_FkMkcVXdPQ3R1VTvgDg6fpQr_W2KqPgz27yTwTW7mt5268s4lG-N5Bm86w_SPZrVTHQK17wGxM1W2BhXCz7K2QHHW7LH1sk5RX5p5W6bRWwY6T409XW5Kq07G1M6kQ1W5cRzll70nT2dW2hVzy94fBBYBW176K5s4R6V3cN8fn6l5SQkxCW6Mw8cF6wv1QcW1BgLSh4f0KrFW2JQJwc71_FY1W1cxkWw23P244W2QxQcD7