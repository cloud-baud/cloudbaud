
# === Provider selection ===
LLM_PROVIDER=writer  # writer|openai|huggingface
WRITER_API_KEY=
WRITER_MODEL=palmyra-x5
OPENAI_API_KEY=
HF_API_TOKEN=

# === Embeddings & Vector store ===
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE=in_memory  # in_memory|qdrant|azure_ai_search
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=writer-rag

# === Azure AI Search (optional) ===
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=writer-rag

# === App & Observability ===
APP_ENV=local
LOG_LEVEL=INFO
MLFLOW_TRACKING_URI=http://localhost:5000
